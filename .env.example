# ==============================================================================
# Lenny Growth Assistant - Master Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
PROJECT_NAME="Lenny Growth Assistant"
DEBUG=true
SECRET_KEY=generate_a_secure_random_secret_for_production_use_min_32_chars

# API & Networking
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
ALLOWED_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# PostgreSQL Database (Supabase Compatible)
# ------------------------------------------------------------------------------
# Default local Docker values:
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lenny_growth

# Async SQLAlchemy connection string
# Format for local docker: postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/lenny_growth

# Supabase direct/pooled string (if using hosted Supabase, uncomment and fill):
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# Chroma Vector Database
# ------------------------------------------------------------------------------
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=lenny_growth_knowledge
# Set to true if running Chroma in-memory/local directory instead of server
CHROMA_PERSISTENCE_DIR=./chroma_data

# ------------------------------------------------------------------------------
# LLM Providers (OpenAI & Ollama)
# ------------------------------------------------------------------------------
# Active LLM Provider: "openai" or "ollama"
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Ollama Local LLM Configuration (Use host.docker.internal when inside Docker)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ------------------------------------------------------------------------------
# Frontend Variables
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
